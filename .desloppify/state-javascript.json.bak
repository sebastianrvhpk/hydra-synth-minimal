            "sample": [
              "function rn(x=1) {return Math.random()*x;}// gives a random number between 0 and 1",
              "function btw(x, y) {return rn() * (y - x) + x;}; // gives a random number between x and y",
              "function intgr(x, y) {x = Math.ceil(x);y = Math.floor(y);return Math.floor(rn() * (y - x + 1)) + x;}; // gives a randon integer between x and y",
              "function bi(x=.5) {return rn()>x?1:-1}; // gives 1 or -1, to change the polarity of a parameter"
            ]
          },
