{
  "name": "hydra-synth",
  "version": "2.0.0-alpha.0",
  "description": "Hydra v2 browser host and WebGPU adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
