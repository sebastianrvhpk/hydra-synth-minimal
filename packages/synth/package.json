{
  "name": "hydra-synth",
  "version": "2.0.0-alpha.1",
  "description": "TypeGPU-backed Hydra video synth runtime, capture, and livecoding exports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./livecoding": {
      "types": "./dist/livecoding.d.ts",
      "import": "./dist/livecoding.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "mp4box": "2.3.0",
    "typegpu": "0.11.9",
    "web-naga": "1.0.1"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@webgpu/types": "0.1.64",
    "vite": "7.3.1"
  }
}
