{
  "name": "hydra-synth-workspace",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter './packages/*' run build",
    "build:sites": "pnpm build:vercel && node scripts/build-sites-static.mjs && node scripts/verify-sites-static.mjs",
    "build:vercel": "pnpm build && node scripts/build-vercel-static.mjs && node scripts/verify-static-app.mjs dist/hydra/index.html",
    "dev": "pnpm build && node scripts/dev-server.mjs --open",
    "dev:no-open": "pnpm build && node scripts/dev-server.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "pnpm test:unit",
    "test:unit": "pnpm exec vitest run --config vitest.config.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 --filter './packages/*' run typecheck",
    "verify:pack": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.1.1"
  }
}
